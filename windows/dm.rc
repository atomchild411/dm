// Windows resources: the manifest, the icon (named GLFW_ICON: GLFW gives it
// to the window too) and the version.  A template: the Makefile fills in
// the @...@ words from VERSION and DM_BUILD.

1 24 "@MANIFEST@"

GLFW_ICON ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEOS 0x40004
FILETYPE 1
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Discord Messenger"
			VALUE "FileVersion", "@VERSION_FULL@"
			VALUE "ProductName", "Discord Messenger"
			VALUE "ProductVersion", "@VERSION_FULL@"
			VALUE "LegalCopyright", "MIT licence; see LICENSE"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
