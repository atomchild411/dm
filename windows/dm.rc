// Windows resources: the manifest, the icon (named GLFW_ICON: GLFW gives it
// to the window too) and the version.

1 24 "dm.manifest"

GLFW_ICON ICON "../irix/icon_discord.ico"

1 VERSIONINFO
FILEVERSION 1,11,0,0
PRODUCTVERSION 1,11,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Discord Messenger"
			VALUE "FileVersion", "1.11"
			VALUE "ProductName", "Discord Messenger"
			VALUE "ProductVersion", "1.11"
			VALUE "LegalCopyright", "MIT licence; see LICENSE"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
