# The portable Linux build (linux/build.sh): Ubuntu 22.04, so what it makes
# runs on distributions from about 2022 on (glibc 2.35).  The libraries are
# built from source and linked in (inside-portable.sh); X11's and Wayland's
# headers are for GLFW, Xvfb and Mesa for the test run.
FROM docker.io/library/ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        g++ make cmake ninja-build patch perl python3 pkg-config curl ca-certificates xz-utils file \
        zlib1g-dev libgl-dev libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
        libxext-dev libxkbcommon-dev libwayland-dev wayland-protocols \
        squashfs-tools icoutils xvfb libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*
